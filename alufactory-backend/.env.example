# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/alufactory_db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=2592000  # 30 days in seconds

# Admin login override (optional)
# If set, this admin phone can login ONLY with ADMIN_OVERRIDE_PASSWORD,
# and DB-stored password will be ignored.
# ADMIN_OVERRIDE_PHONE=13916813579
# ADMIN_OVERRIDE_PASSWORD=your-new-admin-password

# CORS Configuration (for frontend access)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Optional: MayCAD PDF -> editable scene reconstruction through Qwen Vision.
# Keep the API key on the backend; never expose it as a VITE_ variable.
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.7-plus
# Local run_local.py blocks paid remote AI by default. Opt in explicitly when needed.
MAYCAD_ALLOW_REMOTE_AI=0

# Production Configuration (Aliyun)
# DATABASE_URL=mysql+pymysql://aliyun_user:aliyun_password@aliyun_host:3306/alufactory_db
# FLASK_ENV=production
# FLASK_DEBUG=False
